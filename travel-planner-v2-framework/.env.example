# Database (local host development)
POSTGRES_DB=travel_planner
POSTGRES_USER=travel_planner
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://travel_planner:change-me-local-only@localhost:5432/travel_planner

# API
PORT=3000
# Optional interface to listen on; use 127.0.0.1 for host-only local development.
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
DB_CONNECTION_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=10000
# Uploaded private photos and videos; keep this directory on a persistent volume in production.
MEDIA_STORAGE_DIR=
# Set a stable random value (at least 32 bytes) for persistent sessions; blank uses a per-process key.
AUTH_TOKEN_SECRET=
# Access token lifetime, in seconds; maximum 7 days.
AUTH_TOKEN_TTL_SECONDS=604800

# provider: real SMTP / Tencent SMS; local: development-only codes shown on screen.
# Local mode also requires NODE_ENV=development (or test) and binds the API to loopback.
NODE_ENV=development
AUTH_DELIVERY_MODE=provider
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Tencent Cloud SMS template must contain two parameters: code and validity in minutes.
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# Dedicated migrated auth test database; its name must end in _test.
AUTH_TEST_DATABASE_URL=
# Optional Vite server-side proxy override; otherwise follows PORT.
API_PROXY_TARGET=
# npm run dev:shared connects to the shared test backend; this optional override is public.
SHARED_API_PROXY_TARGET=
# Only enable behind a local reverse proxy that replaces client IP headers.
TRUST_PROXY=off

# AMap: Web JS key is public in the browser; restrict it by allowed domain in AMap console.
VITE_AMAP_WEB_KEY=
# Optional security code paired with the browser key; leave empty when not enabled.
VITE_AMAP_SECURITY_CODE=
# Server-side key. Never use a VITE_ prefix for secrets.
AMAP_WEB_SERVICE_KEY=
B_EXTERNAL_TIMEOUT_MS=3000
B_GENERATION_TIMEOUT_MS=20000
B_MAX_ROUTE_CALLS=40
B_PROPOSAL_TTL_MINUTES=30
# Dedicated, pre-created test database only. Never point at a development/production database.
TEST_DATABASE_URL=
# Dedicated trip activity integration database; its name must end in _test.
TRIP_TEST_DATABASE_URL=

# Optional server-side LLM configuration
B_LLM_ENABLED=false
# Model timeout is separate from the map timeout; the total generation deadline still applies.
B_LLM_TIMEOUT_MS=15000
# OpenAI-compatible Chat Completions API base, including /v1 if required by the provider.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
